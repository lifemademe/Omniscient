# GENESYS-SDK-BEGIN
# The following section is managed by the Genesys SDK.
# It will be updated when you update the SDK.
# Add your custom ignore patterns AFTER this section (below GENESYS-SDK-END).

**/.dist/**
**/node_modules/**
**/.engine/**
**/**dist/**
**/**editor/**
**/.DS_Store
**/*.tgz
**/*.mcp-port
.cursor/mcp.json
**/.placeholder
# Regenerated on every project create/update/open (see skills-sync.ts); never commit the link itself.
.claude/skills
# Ignore all of .genesys except the sdk/ folder (SDK base files)
**/.genesys/*
!.genesys/sdk/
!.genesys/sdk/**
**/logs/**
**/.turbo/**
**/.cache/**
**/.intermediate/*

# GENESYS-SDK-END

# ============================================
# Add your custom gitignore patterns below
# These will be preserved during SDK updates
# ============================================

# Contains the local Sandbox Studio MCP bearer token — do not commit
.mcp.json

# Generated previews and debug captures. Regenerate with:
#   pnpm exec tsx scripts/preview-tree.ts
#   pnpm exec tsx scripts/preview-terminal.ts
assets/screenshots/*.jpg
assets/screenshots/*.png
assets/screenshots/*.html


# Python bytecode from scripts/dev.
__pycache__/

# Generated by the SDK build. It was committed by accident once already - it is created
# and removed as builds run, so `git add -A` picks up whichever state the disk is in.
src/.virtual-entry.ts
scripts/.m4ss-art-score.json

# Built by scripts/dev/sheet on demand; regenerated by esbuild every time it is used.
scripts/dev/sheet/bundle.js
scripts/dev/sheet/out/

# Generated by scripts/dev/shader/build.py - a 1.2MB bundle, rebuilt on demand.
scripts/dev/shader/bundle.js
scripts/dev/shader/index.html

# Commit message scratch - never part of the tree.
commitmsg.txt
cm.txt
msg.tmp
